# OTT Update Bot — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# --- Required ---

# TMDB API Read Access Token (from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram channel ID (e.g. @mychannel or -1001234567890)
TELEGRAM_CHANNEL_ID=

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=


# --- MongoDB (optional, defaults shown) ---

MONGODB_DATABASE=ott_update_bot
MONGODB_COLLECTION=posted_items


# --- TMDB region (optional) ---

# ISO 3166-1 alpha-2 country code for watch-region filtering
TMDB_REGION=IN


# --- OTT provider filter (comma-separated canonical names) ---
# Must match keys in app/providers.py PROVIDER_ALIASES

OTT_PROVIDERS=Netflix,Amazon Prime Video,JioHotstar,ZEE5,Sony Pictures Networks India


# --- Date window (optional, defaults shown) ---

# How many days BEFORE today to include in the release window
LOOKBACK_DAYS=1

# How many days AFTER today to include in the release window
LOOKAHEAD_DAYS=1


# --- Behaviour (optional) ---

# Set to true to post a "no releases found" message when there is nothing new
POST_EMPTY_UPDATE=false

# Minimum date-confidence level required to include a title in the post.
# CONFIRMED_DATE  — Only titles where TMDB has a digital release date (type 4)
#                   within the date window. Most accurate but fewest results.
# APPROXIMATE_DATE — Also include titles whose primary/air release date falls
#                   in the window (date may be theatrical, not OTT). Recommended.
# UNKNOWN_DATE    — Include everything, even titles with no usable date. Not recommended.
MIN_RELEASE_CONFIDENCE=APPROXIMATE_DATE
