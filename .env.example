# OTT Update Bot — Environment Variables
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# --- Required ---

# TMDB API Read Access Token (from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram channel ID (e.g. @mychannel or -1001234567890)
TELEGRAM_CHANNEL_ID=

# MongoDB connection string (e.g. from MongoDB Atlas)
MONGODB_URI=


# --- MongoDB (optional, defaults shown) ---

MONGODB_DATABASE=ott_update_bot
MONGODB_COLLECTION=posted_items


# --- TMDB region (optional) ---

# ISO 3166-1 alpha-2 country code for watch-region filtering
TMDB_REGION=IN


# --- OTT provider filter (comma-separated canonical names) ---
# Must match keys in app/providers.py PROVIDER_ALIASES

OTT_PROVIDERS=Netflix,Amazon Prime Video,JioHotstar,ZEE5,Sony Pictures Networks India


# --- Date window (optional, defaults shown) ---

# How many days BEFORE today to include in the confidence window.
# Default is 7 — OTT titles often take a few days to appear in TMDB's
# watch-provider data after release. A 7-day window catches most of the
# current week's new additions. MongoDB dedup prevents re-posting.
LOOKBACK_DAYS=7

# How many days AFTER today to include in the release window
LOOKAHEAD_DAYS=1

# How many days back to search TMDB for candidate titles (wide discover window).
# TMDB's primary_release_date is the theatrical date, not the OTT-addition date.
# This wide window catches all titles released in roughly the last N days that
# are currently on configured platforms. The narrow LOOKBACK_DAYS/LOOKAHEAD_DAYS
# window then filters which of those are "new enough" to post.
# Increase this if you want to catch more back-catalogue OTT additions.
DISCOVER_LOOKBACK_DAYS=90

# --- Schedule (Internal Cron) ---

# The time the bot should run its daily check (in IST - India Standard Time).
# Format must be HH:MM in 24-hour time.
RUN_AT_TIME=08:30

# Whether to run the check immediately when the bot boots up before waiting
# for the scheduled time. Set to true if you want immediate feedback on deploy.
RUN_ON_STARTUP=false


# --- Behaviour (optional) ---

# Set to true to post a "no releases found" message when there is nothing new
POST_EMPTY_UPDATE=false

# Minimum date-confidence level required to include a title in the post.
# CONFIRMED_DATE  — Only titles where TMDB has a digital release date (type 4)
#                   within the date window. Most accurate but fewest results.
# APPROXIMATE_DATE — Also include titles whose primary/air release date falls
#                   in the window (date may be theatrical, not OTT). Recommended.
# UNKNOWN_DATE    — Include everything, even titles with no usable date. Not recommended.
MIN_RELEASE_CONFIDENCE=APPROXIMATE_DATE
